name: liftoff
services:
  nginx:
    container_name: nginx
    image: nginx:1.31.8
    restart: unless-stopped
    volumes:
      - ./nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    ports:
      - "{{ app_nginx_host_port }}:80"

  db:
    container_name: db
    image: mariadb:11.8.9-ubi9
    restart: unless-stopped
    environment:
      - MARIADB_USER=${MARIADB_USER}
      - MARIADB_PASSWORD=${MARIADB_PASSWORD}
      - MARIADB_ROOT_PASSWORD=${MARIADB_ROOT_PASSWORD}
      - MARIADB_DATABASE=${MARIADB_DATABASE}
    volumes:
      - db:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      start_period: 10s
      interval: 10s
      timeout: 5s
      retries: 3

  wordpress:
    container_name: wordpress
    image: wordpress:7.1.4-php8.2-apache
    restart: unless-stopped
    expose:
      - 80
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: ${MARIADB_USER}
      WORDPRESS_DB_PASSWORD: ${MARIADB_PASSWORD}
      WORDPRESS_DB_NAME: ${MARIADB_DATABASE}
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_HOME', '{{ app_url }}');
        define('WP_SITEURL', '{{ app_url }}');
    volumes:
      - wordpress:/var/www/html
    depends_on:
      db:
        condition: service_healthy

  phpmyadmin:
    container_name: phpmyadmin
    image: phpmyadmin:5.2.3-apache
    restart: unless-stopped
    expose:
      - 80
    depends_on:
      db:
        condition: service_healthy
    environment:
      - PMA_HOST=db
      # PMA_ABSOLUTE_URI
  
  wp-cli:
    image: wordpress:cli
    user: 33:33
    profiles:
      - setup
    environment:
      WORDPRESS_DB_HOST: db
      WORDPRESS_DB_USER: ${MARIADB_USER}
      WORDPRESS_DB_PASSWORD: ${MARIADB_PASSWORD}
      WORDPRESS_DB_NAME: ${MARIADB_DATABASE}
      WP_TITLE: ${WP_TITLE}
      WP_ADMIN_USER: ${WP_ADMIN_USER}
      WP_ADMIN_PASSWORD: ${WP_ADMIN_PASSWORD}
      WP_ADMIN_EMAIL: ${WP_ADMIN_EMAIL}
    volumes:
      - wordpress:/var/www/html
      - ./setup.sh:/usr/local/bin/setup.sh:ro
    depends_on:
      db:
        condition: service_healthy
      wordpress:
        condition: service_started
    entrypoint: ["/bin/sh", "/usr/local/bin/setup.sh"]

volumes:
  db:
  wordpress:
